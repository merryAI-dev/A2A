+// A2A Browser: the window frame uses the same light surfaces as our pages.
+void AddA2AColorMixer(ui::ColorProvider* provider,
+                      const ui::ColorProviderKey& key) {
+  if (key.color_mode != ui::ColorProviderKey::ColorMode::kLight ||
+      key.custom_theme) {
+    return;
+  }
+  ui::ColorMixer& mixer = provider->AddMixer();
+  mixer[ui::kColorFrameActive] = {kA2ARaise};
+  mixer[ui::kColorFrameInactive] = {kA2ARaise};
+  mixer[kColorToolbar] = {kA2ARaise};
+  mixer[kColorToolbarContentAreaSeparator] = {kA2ACardLine};
+  mixer[kColorToolbarButtonIcon] = {kA2ACardSub};
+  mixer[kColorToolbarButtonIconInactive] = {kA2ACardSub};
+  mixer[kColorLocationBarBackground] = {kA2AField};
+  mixer[kColorLocationBarBackgroundHovered] = {kA2AField};
+  mixer[kColorTabBackgroundActiveFrameActive] = {kA2ACard};
+  mixer[kColorTabBackgroundActiveFrameInactive] = {kA2ACard};
+  mixer[kColorTabBackgroundInactiveFrameActive] = {kA2ARaise};
+  mixer[kColorTabBackgroundInactiveFrameInactive] = {kA2ARaise};
+  mixer[kColorTabForegroundActiveFrameActive] = {kA2ACardInk};
+  mixer[kColorTabForegroundActiveFrameInactive] = {kA2ACardInk};
+  mixer[kColorTabForegroundInactiveFrameActive] = {kA2ACardSub};
+  mixer[kColorTabForegroundInactiveFrameInactive] = {kA2ACardSub};
+  mixer[kColorSidePanelBackground] = {kA2ARaise};
+  mixer[kColorSidePanelContentBackground] = {kA2ACard};
+}
+
 }  // namespace
 
