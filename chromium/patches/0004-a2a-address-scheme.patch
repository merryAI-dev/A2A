 // Handles the rewriting of the new tab page URL based on group policy.
+// A2A Browser: a2a://메리, a2a://접점, a2a://학습, a2a://업무지도 open the built-in pages;
+// anything else (a2a://홈) opens home.
+// The host of a non-special scheme arrives percent-encoded, so compare unescaped.
+bool HandleA2AScheme(GURL* url, content::BrowserContext* browser_context) {
+  if (!url->SchemeIs("a2a")) {
+    return false;
+  }
+  std::string name =
+      base::UnescapeBinaryURLComponent(url->spec().substr(strlen("a2a://")));
+  while (!name.empty() && name.back() == '/') {
+    name.pop_back();
+  }
+  const char* page = name == "메리"       ? "merry.html"
+                     : name == "학습"     ? "learn.html"
+                     : name == "업무지도" || name == "온톨로지" ? "map.html"
+                     : name == "접점" || name == "접점찾기" || name == "헌터"
+                         ? "contacts.html"
+                         : "newtab.html";
+  *url = GURL(base::StrCat({"chrome-extension://",
+                            extension_misc::kA2AExtensionId, "/", page}));
+  return true;
+}
