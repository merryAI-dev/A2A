+bool IsA2AHome(content::WebContents* contents) {
+  const GURL& url = contents->GetLastCommittedURL();
+  return (url.SchemeIs(extensions::kExtensionScheme) &&
+          url.host() == extension_misc::kA2AExtensionId &&
+          url.path() == "/newtab.html") ||
+         contents->GetVisibleURL() == GURL(chrome::kChromeUINewTabURL);
+}
+
+// A2A Browser: go to the open home tab, or open one, so the current page stays.
+void OpenA2AHome(BrowserWindowInterface* browser) {
+  TabStripModel* model = browser->GetTabStripModel();
+  for (int i = model->count() - 1; i >= 0; --i) {
+    if (IsA2AHome(model->GetWebContentsAt(i))) {
+      model->ActivateTabAt(i);
+      return;
+    }
+  }
+  chrome::NewTab(browser, NewTabTypes::kNewTabCommand);
+}
+
